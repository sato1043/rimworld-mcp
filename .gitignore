# --- Python (mcp_server) ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- C# / RimWorld mod build output ---
# The assemblies under 1.6/Assemblies are build output and are not tracked here.
# MCP.dll is rebuilt from Source/, and the bundled third-party assemblies come from
# the package references pinned in packages.lock.json. Upstream commits all three on
# purpose as the distributable mod; this fork deliberately diverges, so pulling an
# upstream change to them will conflict.
MCP/1.6/Assemblies/*.dll
MCP/**/obj/
MCP/**/bin/
*.pdb
*.user
*.suo

# --- IDE ---
.idea/
.vs/
*.iml

# --- Local tool state ---
# The root .claude/ is local state, except the skills this fork tracks, which are
# listed one by one so that a personal skill or a stray file stays untracked.
# /*/**/.claude/ ignores .claude/ below the root only: **/.claude/ would also match
# the root one and cancel the exceptions. Upstream ignores .claude/ and **/.claude/
# here; this fork replaced those lines, so pulling an upstream change to them will
# conflict.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/rimworld-play/
/*/**/.claude/
.serena/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
